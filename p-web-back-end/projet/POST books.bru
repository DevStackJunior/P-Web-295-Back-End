meta {
  name: POST books
  type: http
  seq: 2
}

post {
  url: http://localhost:3333/books
  body: json
  auth: inherit
}

body:json {
  {
    "title": "Le Seigneur des Anneaux",
    "number_of_pages": 1178,
    "pdf_link": "https://example.com/books/lotr.pdf",
    "abstract": "Un jeune hobbit, Frodon Sacquet, hérite d’un anneau magique et se lance dans une quête périlleuse pour le détruire et sauver la Terre du Milieu.",
    "editor": "Christian Bourgois Éditeur",
    "edition_year": 2002,
    "image_path": "https://example.com/images/lotr-cover.jpg",
    "category_id": 1,
    "writer_id": 1
  }
  
}

settings {
  encodeUrl: true
  timeout: 0
}
